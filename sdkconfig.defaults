CONFIG_IDF_TARGET="esp32"

# M5Paper: ESP32-D0WDQ6-V3, 16MB flash, 8MB PSRAM
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_SPIRAM=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# Match the Arduino core the reference app was written for (1 tick = 1 ms)
CONFIG_FREERTOS_HZ=1000
# FreeType's smooth rasterizer keeps a ~14 KB work pool on the stack
CONFIG_ESP_MAIN_TASK_STACK_SIZE=32768

CONFIG_COMPILER_OPTIMIZATION_PERF=y

# SD card: long UTF-8 file names
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_API_ENCODING_UTF_8=y

# WiFi + PSRAM workarounds overflow IRAM on the ESP32; keep WiFi fast paths in flash
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
